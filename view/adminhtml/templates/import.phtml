        <div class="admin__field"><label class="admin__field-label" for="magmi-profile"><?= $block->escapeHtml(__('Profile')) ?></label><div class="admin__field-control"><select class="admin__control-select" name="profile" id="magmi-profile"><?php foreach ($block->getProfiles() as $profile): ?><option value="<?= $block->escapeHtmlAttr($profile->getName()) ?>"><?= $block->escapeHtml($profile->getName()) ?></option><?php endforeach; ?></select></div></div>
