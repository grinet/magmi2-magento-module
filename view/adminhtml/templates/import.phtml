<?php /** @var \Grinet\Magmi2\Block\Adminhtml\Import $block */ ?>
<p><?= $block->escapeHtml(__('Your Magento connection and media directory are detected automatically.')) ?></p>
<p><?= $block->escapeHtml(__('Place product files in var/import. Browser imports process up to the selected row limit; use the Magmi CLI for larger files.')) ?></p>
